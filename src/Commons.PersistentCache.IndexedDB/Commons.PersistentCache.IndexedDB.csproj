<Project Sdk="Microsoft.NET.Sdk.Razor">
    
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Commons.PersistentCache.IndexedDB</RootNamespace>

        <!-- Package Information -->
        <PackageId>Commons.PersistentCache.IndexedDB</PackageId>
        <Title>Commons.PersistentCache implementation using IndexedDB</Title>
        <Description>Persistent cache implementation on top of IndexedDB</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>cache;persistent;storage;indexeddb;webassembly</PackageTags>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Symbols -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup Condition="'$(DirectProjectReference)' == 'true'">
        <ProjectReference Include="..\Commons.PersistentCache\Commons.PersistentCache.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(DirectProjectReference)' != 'true'">
        <PackageReference Include="Commons.PersistentCache" Version="*" />
    </ItemGroup>


    <!-- Target TargetFramework conditional dependencies-->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.JSInterop" Version="8.0.25" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.JSInterop" Version="9.0.14" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.JSInterop" Version="10.0.4" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    </ItemGroup>
    
    <!--
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3"/>
    </ItemGroup>
    -->
</Project>
